[Unit]
Description=Flycut authenticated event sync
After=network.target

[Service]
Type=simple
User=flycut-sync
WorkingDirectory=/opt/flycut
ExecStart=/usr/bin/python3 -m SyncService.server --database /var/lib/flycut-sync/events.sqlite --env-file /opt/flycut/.env --collection REPLACE-WITH-COLLECTION-UUID
StateDirectory=flycut-sync
UMask=0077
Restart=on-failure
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/flycut-sync

[Install]
WantedBy=multi-user.target
