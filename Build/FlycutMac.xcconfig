FLYCUT_CLOUDKIT = 0
FLYCUT_ICLOUD_CONTAINER = iCloud.net.nowaker.flycut
FLYCUT_CLOUDKIT_LDFLAGS_0 =
FLYCUT_CLOUDKIT_LDFLAGS_1 = -framework CloudKit
FLYCUT_ENTITLEMENTS_0 = Flycut$(FLYCUT_ENTITLEMENTS_SUFFIX).entitlements
FLYCUT_ENTITLEMENTS_1 = Build/FlycutCloudKit.entitlements
CODE_SIGN_ENTITLEMENTS = $(FLYCUT_ENTITLEMENTS_$(FLYCUT_CLOUDKIT))
GCC_PREPROCESSOR_DEFINITIONS = $(inherited) FLYCUT_MAC FLYCUT_CLOUDKIT=$(FLYCUT_CLOUDKIT) FLYCUT_ICLOUD_CONTAINER=\"$(FLYCUT_ICLOUD_CONTAINER)\"
OTHER_LDFLAGS = $(inherited) -lsqlite3 $(FLYCUT_CLOUDKIT_LDFLAGS_$(FLYCUT_CLOUDKIT))
