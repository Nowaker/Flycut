{
  "comment": "Credential detection shared by Flycut (FlycutCredentialDetector.m) and linux-bridge/flycut-copyq-bridge.py. Rules follow gitleaks (github.com/gitleaks/gitleaks, config/gitleaks.toml): a regex, optional lowercase keywords that must appear before the regex is tried, an optional minimum Shannon entropy (bits per character) of capture group 1, and optional allowSecret regexes that clear a capture group 1 matching any of them. Bump version when rules change: clients re-encrypt their sync logs once per version.",
  "version": 1,
  "scanLimit": 65536,
  "rules": [
    {"id": "private-key", "regex": "-----BEGIN[ A-Z0-9_-]{0,100}PRIVATE KEY( BLOCK)?-----", "keywords": ["private key"]},
    {"id": "aws-access-token", "regex": "\\b((?:A3T[A-Z0-9]|AKIA|ASIA|ABIA|ACCA)[A-Z2-7]{16})\\b"},
    {"id": "github-token", "regex": "\\b(?:ghp|gho|ghu|ghs|ghr)_[0-9a-zA-Z]{36}\\b", "keywords": ["gh"]},
    {"id": "github-fine-grained-pat", "regex": "\\bgithub_pat_\\w{82}\\b", "keywords": ["github_pat_"]},
    {"id": "gitlab-token", "regex": "\\b(?:glpat|glptt|gldt|glrt|gloas|glcbt|glffct|glsoat)-[0-9a-zA-Z_-]{20,}", "keywords": ["gl"]},
    {"id": "slack-token", "regex": "\\bxox[abposr]-[0-9A-Za-z-]{10,}", "keywords": ["xox"]},
    {"id": "slack-webhook", "regex": "hooks\\.slack\\.com/(?:services|workflows|triggers)/[A-Za-z0-9+/]{43,56}", "keywords": ["hooks.slack.com"]},
    {"id": "stripe-key", "regex": "\\b(?:sk|rk)_(?:test|live|prod)_[a-zA-Z0-9]{10,99}\\b", "keywords": ["_test_", "_live_", "_prod_"]},
    {"id": "google-api-key", "regex": "\\bAIza[0-9A-Za-z_-]{35}\\b", "keywords": ["aiza"]},
    {"id": "anthropic-api-key", "regex": "\\bsk-ant-[a-z0-9]+-[A-Za-z0-9_-]{20,}", "keywords": ["sk-ant-"]},
    {"id": "openai-api-key", "regex": "\\bsk-(?:proj|svcacct|admin)-[A-Za-z0-9_-]{20,}|\\bsk-[a-zA-Z0-9]{20}T3BlbkFJ[a-zA-Z0-9]{20}", "keywords": ["sk-"]},
    {"id": "npm-token", "regex": "\\bnpm_[A-Za-z0-9]{36}\\b", "keywords": ["npm_"]},
    {"id": "pypi-token", "regex": "pypi-AgEIcHlwaS5vcmc[A-Za-z0-9_-]{50,}", "keywords": ["pypi-"]},
    {"id": "huggingface-token", "regex": "\\bhf_[a-zA-Z]{34}\\b", "keywords": ["hf_"]},
    {"id": "digitalocean-token", "regex": "\\bdo[opr]_v1_[a-f0-9]{64}\\b", "keywords": ["_v1_"]},
    {"id": "sendgrid-api-key", "regex": "\\bSG\\.[A-Za-z0-9_-]{22}\\.[A-Za-z0-9_-]{43}\\b", "keywords": ["sg."]},
    {"id": "shopify-token", "regex": "\\bshp(?:at|ca|pa|ss)_[a-fA-F0-9]{32}\\b", "keywords": ["shp"]},
    {"id": "telegram-bot-token", "regex": "\\b[0-9]{8,10}:AA[0-9A-Za-z_-]{33}\\b", "keywords": [":aa"]},
    {"id": "jwt", "regex": "\\bey[a-zA-Z0-9]{17,}\\.ey[a-zA-Z0-9/\\\\_-]{17,}\\.(?:[a-zA-Z0-9/\\\\_-]{10,}={0,2})?", "keywords": ["ey"]},
    {"id": "url-password", "regex": "\\b[a-z][a-z0-9+.-]*://[^/\\s:@]+:([^/\\s@]{3,})@", "keywords": ["://"]},
    {"id": "url-token-parameter", "regex": "(?i)[?&](?:access_token|api_key|apikey|token|key|secret|password|passwd|signature|sig|auth)=([A-Za-z0-9%._~+/=-]{16,})", "entropy": 3.0, "keywords": ["="]},
    {"id": "generic-api-key", "regex": "(?i)[\\w.-]{0,50}?(?:access|auth|api|credential|creds|key|passw(?:or)?d|secret|token)(?:[ \\t\\w.-]{0,20})[\\s'\"]{0,3}(?:=|>|:{1,3}=|\\|\\||:|=>|\\?=|,)[`'\"\\s=]{0,5}([\\w.=-]{10,150}|[a-z0-9][a-z0-9+/]{11,}={0,3})(?:[`'\"\\s;]|\\\\[nr]|$)", "entropy": 3.5, "allowSecret": ["^[A-Za-z_.-]+$"], "keywords": ["access", "auth", "api", "credential", "creds", "key", "passw", "secret", "token"]},
    {"id": "apple-generated-password", "regex": "^(?=[a-z0-9-]*[A-Z])(?=[A-Za-z-]*[0-9])[A-Za-z0-9]{6}-[A-Za-z0-9]{6}-[A-Za-z0-9]{6}$"}
  ],
  "standalone": {
    "comment": "A clipping that is one word and looks random: a copied password or token. Password-like needs upper, lower, digit and another character; token-like is long, made of token characters, has a run of at least tokenLongestRun letters and digits, is broken by digits at least tokenDigitRuns times and has tokenEntropy.",
    "minLength": 12,
    "maxLength": 256,
    "passwordEntropy": 3.0,
    "tokenMinLength": 20,
    "tokenEntropy": 3.5,
    "tokenDigitRuns": 3,
    "tokenLongestRun": 16,
    "allow": [
      "^[a-z][a-z0-9+.-]*://",
      "^(?:~|\\.{0,2}/)",
      "^[^@\\s]+@[^@\\s]+\\.[A-Za-z]{2,}$",
      "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
      "^[0-9a-f]{7,40}$",
      "^(?:ses|msg|qst|sch|spw|prt|call|toolu|req|bg)_[A-Za-z0-9]+[.,;:]?$",
      "^[a-z]{2,6}_[0-9a-f]{12}[0-9A-Za-z]{14}[.,;:]?$"
    ]
  }
}
