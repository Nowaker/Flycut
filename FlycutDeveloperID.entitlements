<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Entitlements for the Developer ID, direct-download (notarized DMG) build.
	  Deliberately NOT sandboxed, and without the Mac App Store-only iCloud
	  container and aps-environment keys, which require a matching provisioning
	  profile and are invalid for Developer ID distribution.

	  Developer ID releases compile with FLYCUT_CLOUDKIT=0. Accessibility (for synthesizing
	  paste) is governed by TCC, not entitlements. Apple Events automation is
	  kept because, under the hardened runtime, the login-item helper sends
	  Apple Events to System Events.

	  CloudKit opt-in builds use Build/FlycutCloudKit.entitlements instead.
	-->
	<key>com.apple.security.automation.apple-events</key>
	<true/>
</dict>
</plist>
