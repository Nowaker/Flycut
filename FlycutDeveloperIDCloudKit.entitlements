<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  FlycutDeveloperID.entitlements plus CloudKit, used when building with
	  FLYCUT_CLOUDKIT=YES. Requires a paid Apple Developer team with the
	  iCloud.$(FLYCUT_BUNDLE_ID) container registered, and automatic signing
	  to fetch a matching provisioning profile.
	-->
	<key>com.apple.security.automation.apple-events</key>
	<true/>
	<key>com.apple.developer.aps-environment</key>
	<string>development</string>
	<key>com.apple.developer.icloud-container-identifiers</key>
	<array>
		<string>iCloud.$(FLYCUT_BUNDLE_ID)</string>
	</array>
	<key>com.apple.developer.icloud-services</key>
	<array>
		<string>CloudKit</string>
	</array>
</dict>
</plist>
